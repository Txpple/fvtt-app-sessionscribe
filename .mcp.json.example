{
  "_comment": "House convention registers this server at USER scope: claude mcp add -s user sessionscribe -e FOUNDRY_HOST=molten -- node <abs path>/dist/index.js. FOUNDRY_HOST is the default host for Foundry reads (molten | local); every read tool can override it per call.",
  "mcpServers": {
    "sessionscribe": {
      "command": "node",
      "args": ["<abs path>/fvtt-mcp-sessionscribe/dist/index.js"],
      "env": { "FOUNDRY_HOST": "molten" }
    }
  }
}
